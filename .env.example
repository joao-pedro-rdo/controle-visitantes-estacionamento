# â”€â”€ PostgreSQL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=visitantes
DATABASE_URL=postgresql://postgres:change_me@db:5432/visitantes?schema=public
BACKEND_IMAGE=joaoprdo/controle-visitantes-backend
FRONTEND_IMAGE=joaoprdo/controle-visitantes-frontend
IMAGE_TAG=local

# â”€â”€ Backend â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
HOST=0.0.0.0
PORT=5000
ENDPOINT=http://localhost:5000
HTTPS=false

# â”€â”€ VigilÃ¢ncia (cÃ¢meras) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SURVEILLANCE_API_URL=
SURVEILLANCE_API_CAMERA=
SURVEILLANCE_API_USERNAME=
SURVEILLANCE_API_PASSWORD=

# â”€â”€ SeguranÃ§a â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_EXPIRES_IN=1h
IMAGE_ENCRYPTION_KEY=32_character_long_secret_key!
COOKIE_SECRET=change_me_cookie_secret

# â”€â”€ Frontend â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REACT_APP_API_URL=/api
FRONTEND_HTTPS=true
