# â”€â”€ PostgreSQL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=visitantes
DATABASE_URL=postgresql://postgres:change_me@db:5432/visitantes?schema=public
BACKEND_IMAGE=joaoprdo/controle-visitantes-backend
FRONTEND_IMAGE=joaoprdo/controle-visitantes-frontend
IMAGE_TAG=local

# â”€â”€ Backend â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
HOST=0.0.0.0
PORT=5000
ENDPOINT=http://localhost:5000
HTTPS=false

# â”€â”€ VigilÃ¢ncia (cÃ¢meras) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SURVEILLANCE_API_URL=
SURVEILLANCE_API_CAMERA=
SURVEILLANCE_API_USERNAME=
SURVEILLANCE_API_PASSWORD=

# â”€â”€ SeguranÃ§a â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_EXPIRES_IN=1h
IMAGE_ENCRYPTION_KEY=32_character_long_secret_key!
COOKIE_SECRET=change_me_cookie_secret

# Posto da Guarda sem login (opcional). IPs ou faixas CIDR das máquinas da
# guarita, separados por vírgula. Essas máquinas entram como Guarda sem senha.
# Use IP fixo (reserva no DHCP). Vazio = desativado.
GUARDA_TRUSTED_IPS=
# Quantos proxies ficam na frente do backend. No Compose é sempre 1 (Nginx).
# Nunca use "true": permitiria forjar o IP do posto via X-Forwarded-For.
TRUST_PROXY=1

# â”€â”€ Frontend â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REACT_APP_API_URL=/api
FRONTEND_HTTPS=true
# Opcional: caminho para CA PEM local se o registry npm estiver atrás de proxy TLS.
# NPM_CA_FILE=../ssl/npm-ca.pem

# Identidade visual (opcional; vazio = padrão embutido na imagem)
# Logo e fundo ficam numa pasta do host. Caminho relativo à pasta docker/.
# Depois de trocar arquivos ou variáveis: docker compose ... up -d
BRANDING_DIR=../branding
APP_LOGO_FILE=logo.png
APP_BACKGROUND_FILE=bg-cover.png
APP_TITLE=Guarda - 6° RCB
APP_PRIMARY_COLOR=#dc2626
APP_SECONDARY_COLOR=#991b1b
